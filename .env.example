# ═══════════════════════════════════════════════════════════════
# LMS PESV Education — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to `.env` and fill in your values.
# NEVER commit the actual .env file to version control.
# ═══════════════════════════════════════════════════════════════

# ── Database (PostgreSQL) ─────────────────────────────────────
# For local dev: postgresql://user:password@localhost:5432/lms_db
# For Render: automatically provided as DATABASE_URL
DATABASE_URL="postgresql://lms_user:lms_password@localhost:5432/lms_db"

# ── JWT Authentication ────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=""

# ── Server ────────────────────────────────────────────────────
APP_PORT=3200

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGIN="http://localhost:3100"

# ── Frontend API URL ──────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3200/api"

# ── Application URL (used in emails and certificates) ─────────
APP_URL="http://localhost:3100"

# ── Email (SMTP — Brevo) ─────────────────────────────────────
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SMTP_FROM_NAME="Campus Virtual PESV"

# ── Cloudflare R2 Storage (leave empty to use local fallback) ──
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME="lms-uploads"
# R2_PUBLIC_URL=""
