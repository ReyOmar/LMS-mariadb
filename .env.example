# ═══════════════════════════════════════════════════════════════════════════
#  LMS PESV Education — variables de entorno
#
#  Copia este archivo a `.env` y rellena los valores. El `.env` NUNCA se sube
#  al repositorio.
#
#  En producción (cPanel) estas variables se definen en el panel de la
#  aplicación Node, no en un archivo: la API ignora el `.env` cuando
#  NODE_ENV=production, para que la configuración tenga un solo origen.
# ═══════════════════════════════════════════════════════════════════════════

# ── Base de datos (MariaDB / MySQL) ───────────────────────────────────────
# En cPanel el usuario y la base llevan el prefijo de la cuenta: usuario_lms.
# Si la contraseña tiene caracteres especiales, codifícalos (@ → %40).
DATABASE_URL="mysql://lms_user:lms_password@127.0.0.1:3306/lms_db"

# Conexiones simultáneas de la API con la base. Por defecto 10, como mucho 50.
# En cPanel el usuario de base suele tener un cupo (`max_user_connections`) que
# comparten phpMyAdmin y las copias de seguridad: deja al menos 3 libres.
# Ver docs/DESPLIEGUE-CPANEL.md, «Conexiones con la base de datos».
# DATABASE_POOL_SIZE=10

# ── Firma de los tokens de sesión ─────────────────────────────────────────
# Mínimo 32 caracteres. La API no arranca con un valor corto o de ejemplo.
# Genéralo con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=""

# ── Servidor ──────────────────────────────────────────────────────────────
APP_PORT=3200
NODE_ENV=development

# ── Proxy de delante ──────────────────────────────────────────────────────
# De quién se acepta la cabecera que dice cuál es la IP real del visitante.
# En cPanel la API vive detrás de Apache, que entra por el bucle local: con el
# valor por defecto (`loopback`) basta y no hay que declarar nada.
# Sin esto, el límite de peticiones contaría a todo el mundo como una sola
# persona y el sitio se rechazaría a sí mismo con unos pocos usuarios a la vez.
# Sólo amplíalo a direcciones tuyas: confiar de más permite falsear la IP.
# TRUST_PROXY=loopback

# ── Orígenes permitidos (CORS) ────────────────────────────────────────────
# Admite varias URLs separadas por comas: las dos sedes pueden servirse desde
# dominios distintos contra la misma API.
CORS_ORIGIN="http://localhost:3100"

# ── URLs públicas ─────────────────────────────────────────────────────────
# Del cliente: se usa en los enlaces de los correos.
APP_URL="http://localhost:3100"
# De la API: se usa para que las imágenes de los correos sean absolutas.
API_PUBLIC_URL="http://localhost:3200"
# Que consume el navegador. Si apunta a localhost y la página se sirve desde un
# dominio real, el cliente deduce la URL del propio host (ver lib/env.ts).
NEXT_PUBLIC_API_URL="http://localhost:3200/api"

# ── Correo ────────────────────────────────────────────────────────────────
# Opción recomendada en cPanel compartido: API HTTP de Brevo por el puerto 443,
# que funciona aunque el alojamiento bloquee los puertos SMTP salientes.
BREVO_API_KEY=""

# Alternativa por SMTP. Sólo se usa si BREVO_API_KEY está vacío. Con Brevo el
# servidor es smtp-relay.brevo.com y pide usuario y contraseña; sin usuario se
# envía sin autenticarse.
# En desarrollo, `docker compose up -d` levanta un buzón local: apunta aquí
# 127.0.0.1:1025 y lee lo enviado en http://localhost:8025.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-responder@tu-dominio.com"
SMTP_FROM_NAME="Campus Virtual PESV"

# Sin ninguna de las dos opciones el sistema funciona, pero no sale ningún
# correo: los avisos quedan registrados y se descartan.

# ── Almacenamiento de archivos ────────────────────────────────────────────
# Sin configurar, los archivos se guardan en `apps/api/uploads`. En cPanel es
# válido siempre que ese directorio sobreviva a los despliegues.
# Con Cloudflare R2 el almacenamiento es externo y los despliegues no lo tocan.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME="lms-uploads"
# R2_PUBLIC_URL=""

# Secreto con el que se firman las descargas de material reservado (entregas,
# certificados, firmas). Si se omite se usa JWT_SECRET.
# STORAGE_SECRET=""

# ── Tamaño de las subidas ─────────────────────────────────────────────────
# Tope técnico de cualquier archivo, en MB. Por defecto 2048 (2 GB); como mucho
# 5000, lo que Cloudflare R2 admite en una sola subida.
# Dentro de ese tope, cada tarea fija su propio límite y la sede uno general
# (Tema y apariencia → Subida de archivos) para las tareas sin límite propio y
# el material de los docentes. Las imágenes tienen topes fijos de pocos MB.
# En cPanel, Apache también limita el tamaño: ver docs/DESPLIEGUE-CPANEL.md.
# MAX_UPLOAD_MB=2048

# Carpeta donde se escribe cada archivo mientras llega. Por defecto, la temporal
# del sistema (/tmp), que en algunos alojamientos es pequeña: con archivos de
# cientos de MB o más, usa una carpeta de la cuenta (p. ej. /home/usuario/lms-tmp).
# UPLOAD_TMP_DIR=""
