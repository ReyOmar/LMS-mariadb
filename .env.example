# ═══════════════════════════════════════════════════════════════════════════
#  LMS PESV Education — variables de entorno
#
#  Copia este archivo a `.env` y rellena los valores. El `.env` NUNCA se sube
#  al repositorio.
#
#  En producción (cPanel) estas variables se definen en el panel de la
#  aplicación Node, no en un archivo: la API ignora el `.env` cuando
#  NODE_ENV=production, para que la configuración tenga un solo origen.
# ═══════════════════════════════════════════════════════════════════════════

# ── Base de datos (MariaDB / MySQL) ───────────────────────────────────────
# En cPanel el usuario y la base llevan el prefijo de la cuenta: usuario_lms.
# Si la contraseña tiene caracteres especiales, codifícalos (@ → %40).
DATABASE_URL="mysql://lms_user:lms_password@127.0.0.1:3306/lms_db"

# ── Firma de los tokens de sesión ─────────────────────────────────────────
# Mínimo 32 caracteres. La API no arranca con un valor corto o de ejemplo.
# Genéralo con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=""

# ── Servidor ──────────────────────────────────────────────────────────────
APP_PORT=3200
NODE_ENV=development

# ── Orígenes permitidos (CORS) ────────────────────────────────────────────
# Admite varias URLs separadas por comas: las dos sedes pueden servirse desde
# dominios distintos contra la misma API.
CORS_ORIGIN="http://localhost:3100"

# ── URLs públicas ─────────────────────────────────────────────────────────
# Del cliente: se usa en los enlaces de los correos.
APP_URL="http://localhost:3100"
# De la API: se usa para que las imágenes de los correos sean absolutas.
API_PUBLIC_URL="http://localhost:3200"
# Que consume el navegador. Si apunta a localhost y la página se sirve desde un
# dominio real, el cliente deduce la URL del propio host (ver lib/env.ts).
NEXT_PUBLIC_API_URL="http://localhost:3200/api"

# ── Correo ────────────────────────────────────────────────────────────────
# Opción recomendada en cPanel compartido: API HTTP de Brevo por el puerto 443,
# que funciona aunque el alojamiento bloquee los puertos SMTP salientes.
BREVO_API_KEY=""

# Alternativa por SMTP. Sólo se usa si BREVO_API_KEY está vacío.
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-responder@tu-dominio.com"
SMTP_FROM_NAME="Campus Virtual PESV"

# Sin ninguna de las dos opciones el sistema funciona, pero no sale ningún
# correo: los avisos quedan registrados y se descartan.

# ── Almacenamiento de archivos ────────────────────────────────────────────
# Sin configurar, los archivos se guardan en `apps/api/uploads`. En cPanel es
# válido siempre que ese directorio sobreviva a los despliegues.
# Con Cloudflare R2 el almacenamiento es externo y los despliegues no lo tocan.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME="lms-uploads"
# R2_PUBLIC_URL=""

# Secreto con el que se firman las descargas de material reservado (entregas,
# certificados, firmas). Si se omite se usa JWT_SECRET.
# STORAGE_SECRET=""
