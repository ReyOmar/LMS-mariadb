// ═══════════════════════════════════════════════════════════════════════════
//  LMS PESV Education — modelo de datos
//
//  Dos reglas transversales gobiernan este esquema:
//
//  1. SEPARACIÓN POR PAÍS. Colombia y México operan como sedes independientes.
//     Las tablas raíz (`usuarios`, `lms_cursos`, `lms_configuracion`,
//     `lms_solicitudes_acceso`) llevan columna `pais`; el resto lo hereda por
//     relación. Una matrícula sólo es válida si alumno y curso comparten país,
//     invariante que se verifica en `EnrollmentsService`.
//
//  2. CALIFICACIÓN SOBRE 100. Toda nota vive en el rango 0–100 y el umbral de
//     aprobación por defecto es 80. Ver `src/common/domain/grading.ts`.
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ── Separación por país ────────────────────────────────────────────────────

enum Country {
  COLOMBIA
  MEXICO
}

// ── Autenticación ──────────────────────────────────────────────────────────

enum Role {
  ADMIN   @map("ADMINISTRADOR")
  TEACHER @map("PROFESOR")
  STUDENT @map("ESTUDIANTE")
}

model User {
  guid      String   @id @default(uuid())
  // El correo identifica a la persona en todo el sistema: una persona pertenece a
  // una sola sede. Cambiar esto a @@unique([email, pais]) rompería la recuperación
  // de contraseña, que sólo dispone del correo.
  email     String   @unique
  password  String?  @map("contrasena") // Nulo mientras el administrador no fija clave temporal
  firstName String   @map("nombre")
  lastName  String   @map("apellido")
  role      Role     @default(STUDENT) @map("rol")
  country   Country  @map("pais")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lastAccessAt        DateTime? @map("ultimo_acceso")
  usesDefaultPassword Boolean   @default(true) @map("usa_clave_defecto")

  /// Prueba de la autorización de tratamiento de datos: cuándo la dio y sobre qué versión
  /// de la política. Si la política cambia, se vuelve a pedir al entrar.
  dataConsentAt      DateTime? @map("consentimiento_fecha")
  dataConsentVersion String?   @map("consentimiento_version") @db.VarChar(40)

  /// Identificador (`jti`) de la sesión válida en este momento.
  /// El campus admite una sesión activa por cuenta: compartir credenciales invalidaría la
  /// certificación, que acredita que una persona concreta hizo la formación. Guardarlo en
  /// la fila del usuario —y no sólo en memoria— hace que la política sobreviva a un
  /// reinicio del servidor.
  currentSessionJti String? @map("sesion_actual_jti")

  // Firma del examinador, impresa en los certificados que emite
  signatureUrl   String? @map("firma_url")
  signatureName  String? @map("firma_nombre")
  signatureTitle String? @map("firma_cargo")

  photoUrl String? @map("foto_url")

  taughtCourses       Course[]
  enrollments         Enrollment[]
  submissions         Submission[]
  resourceProgress    ResourceProgress[]
  notifications       Notification[]
  certificates        Certificate[]
  archivedSubmissions ArchivedSubmission[]
  studySessions       StudySession[]
  sentMessages        Message[]            @relation("SentMessages")
  receivedMessages    Message[]            @relation("ReceivedMessages")
  hiddenConversations HiddenConversation[] @relation("HiddenConversationOwner")
  hiddenByContacts    HiddenConversation[] @relation("HiddenConversationContact")
  requestedContacts   ChatContact[]        @relation("RequestedContacts")
  receivedContacts    ChatContact[]        @relation("ReceivedContacts")

  // El listado de cuentas filtra por sede y rol y ordena por fecha de alta. Sin la fecha
  // en el índice la base ordenaba la sede entera en cada página: con 20.000 cuentas eran
  // 31 ms por página frente a 1 ms con el índice. Reemplaza a `(pais, rol)`, del que es
  // prefijo, así que los recuentos por rol siguen resueltos con el mismo índice.
  @@index([country, role, createdAt])
  // Antes de borrar una foto o una firma sustituidas se comprueba que ninguna fila las use
  // (`FileOwnershipService`): sin ellos, cada comprobación recorría la tabla entera.
  @@index([photoUrl])
  @@index([signatureUrl])
  @@map("usuarios")
}

model EmailVerification {
  id        Int      @id @default(autoincrement())
  email     String
  code      String   @map("codigo") // 6 dígitos
  verified  Boolean  @default(false) @map("verificado")
  /// Intentos fallidos. El código se invalida al agotarlos: 6 dígitos son adivinables
  /// si se puede probar sin límite desde muchas direcciones.
  attempts  Int      @default(0) @map("intentos")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([expiresAt])
  @@map("lms_verificacion_email")
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  email     String
  token     String   @unique
  used      Boolean  @default(false) @map("usado")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([expiresAt])
  @@map("lms_password_resets")
}

// ── Solicitudes de acceso ──────────────────────────────────────────────────

enum AccessRequestStatus {
  PENDING  @map("PENDIENTE")
  ACCEPTED @map("ACEPTADA")
  REJECTED @map("RECHAZADA")
}

model AccessRequest {
  id              Int                 @id @default(autoincrement())
  email           String              @unique
  firstName       String              @map("nombre")
  lastName        String              @map("apellido")
  requestedRole   Role                @map("rol_pedido")
  country         Country             @map("pais")
  status          AccessRequestStatus @default(PENDING) @map("estado")
  // Motivo del rechazo: se le comunica por correo a quien la envió y queda como constancia
  rejectionReason String?             @map("motivo") @db.VarChar(500)
  // Autorización de tratamiento de datos dada al enviar la solicitud; pasa a la cuenta al aprobarla.
  consentAt       DateTime?           @map("consentimiento_fecha")
  consentVersion  String?             @map("consentimiento_version") @db.VarChar(40)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@index([country, status])
  @@map("lms_solicitudes_acceso")
}

// ── Cursos y contenido ─────────────────────────────────────────────────────

enum CourseStatus {
  DRAFT     @map("BORRADOR")
  PUBLISHED @map("PUBLICADO")
  /// Sólo de la versión de julio: se conserva para leer esos cursos, que se sacan de aquí
  /// pasándolos a borrador o publicándolos. La aplicación ya no archiva.
  ARCHIVED  @map("ARCHIVADO")
}

enum DifficultyLevel {
  BEGINNER     @map("PRINCIPIANTE")
  INTERMEDIATE @map("INTERMEDIO")
  ADVANCED     @map("AVANZADO")
  EXPERT       @map("EXPERTO")
}

/// Un vídeo es un enlace y un documento, un adjunto. VIDEO y PDF no los creó nunca ninguna
/// versión: se conservan para no tener que alterar la columna.
enum ResourceType {
  TEXT       @map("TEXTO")
  VIDEO
  PDF
  LINK       @map("ENLACE")
  ASSIGNMENT @map("TAREA")
}

model Course {
  guid             String          @id @default(uuid())
  country          Country         @map("pais")
  title            String          @map("titulo")
  description      String?         @map("descripcion") @db.Text
  shortDescription String?         @map("descripcion_corta")
  coverImage       String?         @map("imagen_portada")
  level            DifficultyLevel @default(BEGINNER) @map("nivel")
  status           CourseStatus    @default(DRAFT) @map("estado")
  /// Primera vez que se publicó. Al volver a publicarlo, distingue el fin de un mantenimiento
  /// de una primera publicación: cambia lo que se les dice a los matriculados.
  firstPublishedAt DateTime?       @map("fecha_primera_publicacion")
  durationHours    Int?            @map("duracion_horas")
  maxStudents      Int?            @map("max_estudiantes")

  // Reglas de negocio
  // Nota mínima para aprobar, en escala 0–100 (ver common/domain/grading.ts)
  passingScore Decimal @default(80) @map("nota_aprobacion") @db.Decimal(5, 2)
  strictOrder  Boolean @default(true) @map("orden_estricto") // Obliga a avanzar sin saltarse recursos

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  teacherGuid   String         @map("profesor_guid")
  teacher       User           @relation(fields: [teacherGuid], references: [guid], onDelete: Restrict)
  modules       CourseModule[]
  enrollments   Enrollment[]
  certificates  Certificate[]
  studySessions StudySession[]
  chatContacts  ChatContact[]

  archivedSubmissions ArchivedSubmission[]

  @@index([teacherGuid])
  @@index([country, status])
  // Comprobar si una portada sustituida sigue en uso (`FileOwnershipService`).
  @@index([coverImage])
  @@map("lms_cursos")
}

model CourseModule {
  guid        String   @id @default(uuid())
  courseGuid  String   @map("curso_guid")
  course      Course   @relation(fields: [courseGuid], references: [guid], onDelete: Cascade)
  title       String   @map("titulo")
  description String?  @map("descripcion")
  position    Int      @default(0) @map("orden")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  resources Resource[]

  @@index([courseGuid, position])
  @@map("lms_modulos")
}

model Resource {
  guid       String       @id @default(uuid())
  moduleGuid String       @map("modulo_guid")
  module     CourseModule @relation(fields: [moduleGuid], references: [guid], onDelete: Cascade)
  title      String       @map("titulo")
  type       ResourceType @map("tipo")

  contentHtml  String? @map("contenido_html") @db.MediumText
  fileUrl      String? @map("url_archivo")
  referenceUrl String? @map("url_referencia") @db.Text // Enlace externo complementario

  // Clave del adjunto en el almacenamiento (ej. "recursos/1699-ab.pdf"), no el binario
  attachmentKey  String? @map("archivo_adjunto")
  attachmentName String? @map("archivo_adjunto_nombre") // Nombre original, para la descarga
  maxUploadMb    Int?    @map("archivo_max_size_mb") // Límite de subida para la entrega del alumno

  // Configuración del cuestionario cuando `type` es ASSIGNMENT. JSON serializado; su forma
  // y validación están en `src/courses/quiz-config.ts`. Contiene las respuestas
  // correctas, por lo que nunca se envía íntegro a un estudiante.
  quizConfig String? @map("quiz_config") @db.MediumText

  position  Int      @default(0) @map("orden")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  progress            ResourceProgress[]
  submissions         Submission[]
  archivedSubmissions ArchivedSubmission[]

  @@index([moduleGuid, position])
  // Comprobar si un archivo sustituido sigue en uso (`FileOwnershipService`).
  @@index([attachmentKey])
  @@index([fileUrl])
  @@map("lms_recursos")
}

// ── Entregas y evaluación ──────────────────────────────────────────────────

enum SubmissionStatus {
  DRAFT     @map("BORRADOR") // Intento de cuestionario en curso
  SUBMITTED @map("ENTREGADA")
  GRADED    @map("CALIFICADA")
  IN_REVIEW @map("EN_REVISION") // Reenvío tras una calificación insuficiente
}

model Submission {
  guid           String    @id @default(uuid())
  userGuid       String    @map("usuario_guid")
  user           User      @relation(fields: [userGuid], references: [guid], onDelete: Cascade)
  assignmentGuid String?   @map("tarea_guid")
  assignment     Resource? @relation(fields: [assignmentGuid], references: [guid], onDelete: SetNull)

  attachmentKey  String? @map("url_archivo_adjunto") // Clave en el almacenamiento
  attachmentName String? @map("respuesta_texto") // Nombre original del archivo entregado

  status        SubmissionStatus @default(SUBMITTED) @map("estado")
  attemptNumber Int              @default(1) @map("intento_numero")
  startedAt     DateTime?        @map("fecha_inicio") // Inicio del intento, para el límite de tiempo
  submittedAt   DateTime?        @map("fecha_entrega")

  // Nota en escala 0–100. Nula mientras no se haya calificado.
  score    Decimal? @map("calificacion") @db.Decimal(5, 2)
  feedback String?  @map("comentario_calificacion") @db.Text

  // El archivo se borró al emitirse el certificado de la vuelta; nombre, nota y comentario siguen.
  filePurged Boolean @default(false) @map("archivo_purgado")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userGuid])
  // Las entregas de un alumno en una tarea. Con el estado y la nota dentro, los paneles que
  // parten de las matrículas (tareas y monitoreo) cuentan y reparten notas sin leer las
  // filas: a 5 años, 2,8 s → 2,2 s el panel de tareas en curso y 9 s → 5 s el histórico.
  @@index([assignmentGuid, userGuid, status, score])
  @@index([status, submittedAt])
  // La cola del examinador: las tareas de un curso, por estado y de la más reciente a la
  // más antigua. Sin él, una página recorría el rango entero de un estado en toda la sede.
  @@index([assignmentGuid, status, submittedAt])
  // Actividad semanal del panel de administración: sin él recorría todas las entregas de la
  // historia para quedarse con las de 7 días (5 años de datos: 661 ms frente a 25).
  @@index([submittedAt])
  // La mejor nota de cada alumno en cada evaluación (promedio de la sede y métricas del
  // alumno) sale del índice sin leer las filas.
  @@index([status, userGuid, assignmentGuid, score])
  // Antes de borrar un archivo sustituido se comprueba que ninguna fila lo use: sin él, cada
  // reenvío, foto o portada nuevos recorrían todas las entregas de la historia.
  @@index([attachmentKey])
  @@map("lms_entregas")
}

model ResourceProgress {
  id           Int      @id @default(autoincrement())
  userGuid     String   @map("usuario_guid")
  user         User     @relation(fields: [userGuid], references: [guid], onDelete: Cascade)
  resourceGuid String   @map("recurso_guid")
  resource     Resource @relation(fields: [resourceGuid], references: [guid], onDelete: Cascade)
  completed    Boolean  @default(true) @map("completado")
  completedAt  DateTime @default(now()) @map("fecha_completado")

  @@unique([userGuid, resourceGuid])
  // Con el usuario dentro, el avance por curso se agrupa leyendo sólo el índice: sin él, el
  // resumen de monitoreo volvía a la tabla por cada una de las filas (139 ms frente a 96).
  @@index([resourceGuid, userGuid])
  @@index([completedAt])
  @@map("lms_progreso_recurso")
}

// ── Matrículas ─────────────────────────────────────────────────────────────

/// Toda matrícula la hace el personal (MANUAL). Las otras dos son de la versión de julio y se
/// conservan para leer sus matrículas.
enum EnrollmentType {
  MANUAL
  ACCESS_CODE @map("CODIGO_ACCESO")
  SYSTEM      @map("SISTEMA")
}

model Enrollment {
  id           Int            @id @default(autoincrement())
  userGuid     String         @map("usuario_guid")
  user         User           @relation(fields: [userGuid], references: [guid], onDelete: Cascade)
  courseGuid   String         @map("curso_guid")
  course       Course         @relation(fields: [courseGuid], references: [guid], onDelete: Cascade)
  type         EnrollmentType @default(MANUAL) @map("tipo")
  active       Boolean        @default(true) @map("activa")
  /// Inicio de la vuelta actual: se renueva al abrir una vuelta nueva, no al retomar tras una baja.
  enrolledAt   DateTime       @default(now()) @map("fecha_matricula")
  unenrolledAt DateTime?      @map("fecha_baja")

  /// Cuándo terminó la vuelta actual: la fecha del certificado que la cerró. Nulo mientras
  /// el curso está en curso. Una matrícula activa y terminada sigue dando acceso al curso y
  /// al chat con su profesor, pero ya no es formación pendiente: ni recibe recordatorios ni
  /// cuenta en el trabajo vivo de los paneles.
  completedAt DateTime? @map("fecha_finalizacion")

  /// Recursos del curso que el alumno tiene completados. Es un recuento derivado de
  /// `lms_progreso_recurso`, guardado para que el monitoreo no tenga que agrupar todo el
  /// progreso de la sede: lo recalcula `refreshCompletedResources` en cada cambio de avance
  /// y la tarea nocturna lo reconcilia en las matrículas en curso (el borrado de contenido,
  /// en cascada, no pasa por ningún servicio).
  completedResources Int @default(0) @map("recursos_completados")

  @@unique([userGuid, courseGuid])
  // La lista de matriculados de un curso va por fecha; con la fecha en el índice la base
  // no tiene que ordenar el curso entero para devolver una página.
  @@index([courseGuid, enrolledAt])
  // Las matrículas en curso de unos cursos (monitoreo, panel de tareas): sin él se leía la
  // tabla entera en cada consulta (página del monitoreo a 5 años: 457 ms frente a 57).
  @@index([courseGuid, active, completedAt])
  @@map("lms_matriculas")
}

// ── Comunicación ───────────────────────────────────────────────────────────

/// DEADLINE_SOON, DEADLINE_URGENT y GLOBAL_ANNOUNCEMENT son de la versión de julio: la
/// aplicación ya no los crea, pero sus avisos se siguen leyendo.
enum NotificationType {
  NEW_ASSESSMENT      @map("EVALUACION_NUEVA")
  DEADLINE_SOON       @map("DEADLINE_PROXIMO")
  DEADLINE_URGENT     @map("DEADLINE_URGENTE")
  ASSIGNMENT_GRADED   @map("TAREA_CALIFICADA")
  COURSE_ANNOUNCEMENT @map("ANUNCIO_CURSO")
  GLOBAL_ANNOUNCEMENT @map("ANUNCIO_GLOBAL")
  COURSE_WELCOME      @map("BIENVENIDA_CURSO")
  BADGE_UNLOCKED      @map("BADGE_DESBLOQUEADO")
  MODULE_COMPLETED    @map("MODULO_COMPLETADO")
  MODULE_RESET        @map("MODULO_REINICIADO")
  SUBMISSION_REVIEW   @map("REVISION_ENTREGA")
  SUBMISSION_REJECTED @map("ENTREGA_RECHAZADA")
  COURSE_REACTIVATED  @map("CURSO_REACTIVADO")
  INACTIVITY_REMINDER @map("RECORDATORIO_INACTIVIDAD")
  NEW_MESSAGE         @map("MENSAJE_NUEVO")
}

model Notification {
  id        Int              @id @default(autoincrement())
  userGuid  String           @map("usuario_guid")
  user      User             @relation(fields: [userGuid], references: [guid], onDelete: Cascade)
  type      NotificationType @map("tipo")
  // Cabe «Mensaje de» seguido del nombre completo más largo que admite una cuenta.
  title     String           @map("titulo") @db.VarChar(255)
  message   String           @map("mensaje") @db.Text
  read      Boolean          @default(false) @map("leida")
  actionUrl String?          @map("url_accion")
  refType   String?          @map("ref_tipo") // Ver NOTIFICATION_REF
  refGuid   String?          @map("ref_guid")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userGuid, read])
  // Al borrar un curso, una tarea o una cuenta se retiran los avisos que apuntan a ellos.
  @@index([refType, refGuid])
  @@index([userGuid, createdAt])
  // El recordatorio de inactividad busca, alumno por alumno, si ya se le avisó en los
  // últimos días: sin él materializaba todos los avisos de la tabla (1,6 s frente a 37 ms).
  @@index([userGuid, type, createdAt])
  @@map("lms_notificaciones")
}

model Message {
  id            Int      @id @default(autoincrement())
  senderGuid    String   @map("remitente_guid")
  sender        User     @relation("SentMessages", fields: [senderGuid], references: [guid], onDelete: Cascade)
  recipientGuid String   @map("destinatario_guid")
  recipient     User     @relation("ReceivedMessages", fields: [recipientGuid], references: [guid], onDelete: Cascade)
  subject       String   @map("asunto")
  content       String   @map("contenido") @db.Text
  read          Boolean  @default(false) @map("leido")
  refType       String?  @map("ref_tipo")
  refGuid       String?  @map("ref_guid")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([senderGuid, recipientGuid])
  @@index([recipientGuid, read])
  @@map("lms_mensajes")
}

enum ContactStatus {
  PENDING  @map("PENDIENTE")
  ACCEPTED @map("ACEPTADO")
  REJECTED @map("RECHAZADO")
}

/**
 * Hasta qué momento ha ocultado alguien su copia de una conversación.
 * Borrar la conversación es una decisión de quien la borra: la otra persona conserva la
 * suya. Se guarda un punto de corte por pareja en lugar de una marca por mensaje —vaciar
 * una conversación larga es una sola escritura, no una por mensaje— y los mensajes
 * posteriores vuelven a verse, que es lo que se espera al seguir hablando.
 */
model HiddenConversation {
  id          Int      @id @default(autoincrement())
  userGuid    String   @map("usuario_guid")
  user        User     @relation("HiddenConversationOwner", fields: [userGuid], references: [guid], onDelete: Cascade)
  contactGuid String   @map("contacto_guid")
  contact     User     @relation("HiddenConversationContact", fields: [contactGuid], references: [guid], onDelete: Cascade)
  /**
   * Los mensajes anteriores a este instante no se le muestran a `usuario_guid`.
   */
  hiddenUntil DateTime @map("oculta_hasta")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([userGuid, contactGuid])
  @@map("lms_conversacion_oculta")
}

model ChatContact {
  id            Int           @id @default(autoincrement())
  requesterGuid String        @map("solicitante_guid")
  requester     User          @relation("RequestedContacts", fields: [requesterGuid], references: [guid], onDelete: Cascade)
  receiverGuid  String        @map("receptor_guid")
  receiver      User          @relation("ReceivedContacts", fields: [receiverGuid], references: [guid], onDelete: Cascade)
  // El contacto es dentro de un curso: si el curso se borra, el contacto se va con él.
  courseGuid    String        @map("curso_guid")
  course        Course        @relation(fields: [courseGuid], references: [guid], onDelete: Cascade)
  status        ContactStatus @default(PENDING) @map("estado")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@unique([requesterGuid, receiverGuid, courseGuid])
  @@index([receiverGuid, status])
  @@index([requesterGuid, status])
  @@map("lms_contacto_chat")
}

// ── Métricas y seguimiento ─────────────────────────────────────────────────

/**
 * Tiempo que un alumno dedica de verdad a un curso.
 * Es la única fuente del tiempo de capacitación: las cifras del panel del alumno, las del
 * examinador y las horas que imprime el certificado se suman de aquí al vuelo. No hay
 * tabla de totales acumulados, y es a propósito: un total guardado se desincroniza en
 * cuanto algo se borra o se rehace, y estas sumas son baratas.
 * Cada fila es un tramo de trabajo real: se abre cuando el alumno empieza a interactuar
 * dentro del curso y se cierra cuando deja de hacerlo. Tener la pestaña abierta sin tocar
 * nada no suma (lo decide el cliente, en `useStudyTime`).
 */
model StudySession {
  id              Int       @id @default(autoincrement())
  userGuid        String    @map("usuario_guid")
  user            User      @relation(fields: [userGuid], references: [guid], onDelete: Cascade)
  courseGuid      String    @map("curso_guid")
  course          Course    @relation(fields: [courseGuid], references: [guid], onDelete: Cascade)
  startedAt       DateTime  @default(now()) @map("inicio_sesion")
  endedAt         DateTime? @map("fin_sesion")
  durationSeconds Int       @default(0) @map("duracion_seg")

  // El latido de cada minuto busca el tramo abierto por su fin: con la fecha en el índice lo
  // encuentra sin ordenar los tramos del alumno en el curso.
  @@index([userGuid, courseGuid, endedAt])
  @@index([courseGuid])
  @@map("lms_sesion_activa")
}

// ── Certificados ───────────────────────────────────────────────────────────

/**
 * Certificado emitido al completar un curso.
 * Un alumno puede repetir el mismo curso años después —otra infracción, otra capacitación—
 * y cada vuelta emite **su propio certificado**. El anterior no se borra: su código de
 * verificación es público y puede estar impreso en un documento ya entregado, así que
 * anularlo haría desaparecer una formación que sí ocurrió. Lo que hace el nuevo es
 * sustituirlo, y el viejo queda como histórico con su fecha y su vigencia.
 */
model Certificate {
  id               Int       @id @default(autoincrement())
  guid             String    @unique @default(uuid())
  /**
   * Titular, mientras su cuenta exista. Queda en nulo si se borra: el certificado sigue
   * acreditando la formación y se verifica con el nombre guardado en `holderName`.
   */
  userGuid         String?   @map("usuario_guid")
  user             User?     @relation(fields: [userGuid], references: [guid], onDelete: SetNull)
  // Nombre completo del titular tal como se emitió; no cambia si después edita su perfil.
  holderName       String    @map("nombre_titular") @db.VarChar(255)
  // Sede que lo emitió. Se guarda aquí porque la cuenta y el curso pueden borrarse después.
  country          Country   @map("pais")
  /**
   * El curso del que salió, mientras siga existiendo.
   * Queda en nulo si el curso se elimina: el certificado acredita una formación que
   * ocurrió y no puede desaparecer porque después se retire el curso del catálogo.
   */
  courseGuid       String?   @map("curso_guid")
  course           Course?   @relation(fields: [courseGuid], references: [guid], onDelete: SetNull)
  /**
   * Título con el que se emitió.
   * Se guarda aquí y no se lee del curso a propósito: un certificado es un documento con
   * fecha, y renombrar el curso no puede cambiar lo que acredita uno ya entregado.
   */
  courseTitle      String    @map("curso_titulo")
  /**
   * Número de vuelta del alumno por este curso: 1 la primera vez, 2 la siguiente…
   */
  attempt          Int       @default(1) @map("intento")
  verificationCode String    @unique @map("codigo_verificacion")
  pdfKey           String    @map("archivo_pdf") // Clave en el almacenamiento
  /// Lo que imprime el PDF, en JSON (`CertificateSnapshot`), para recomponerlo si el archivo se
  /// pierde. Nulo en los certificados anteriores a esta columna.
  pdfData          String?   @map("datos_pdf") @db.Text
  startedAt        DateTime  @map("fecha_inicio")
  completedAt      DateTime  @default(now()) @map("fecha_completado")
  /**
   * Hasta cuándo acredita, según la vigencia configurada en la sede. Nulo = sin caducidad.
   */
  validUntil       DateTime? @map("valido_hasta")
  totalHours       Decimal   @default(0) @map("tiempo_total_horas") @db.Decimal(10, 2)
  activeSeconds    Int       @default(0) @map("tiempo_activo_seg")
  // Promedio del curso en escala 0–100
  averageScore     Decimal?  @map("nota_promedio") @db.Decimal(5, 2)
  createdAt        DateTime  @default(now()) @map("created_at")

  // La restricción única sirve también de índice por alumno: empieza por `usuario_guid`.
  @@unique([userGuid, courseGuid, attempt])
  @@index([courseGuid])
  // Comprobar si un archivo sigue en uso antes de borrarlo (`FileOwnershipService`): los
  // certificados crecen con los años, como las entregas.
  @@index([pdfKey])
  @@map("lms_certificados")
}

// ── Configuración por sede ─────────────────────────────────────────────────

/// Una fila por país. Marca, textos de la landing y textos legales son propios de
/// cada sede: los datos de contacto, la dirección y la normativa difieren entre
/// Colombia y México.
model CountrySettings {
  id      Int     @id @default(autoincrement())
  country Country @unique @map("pais")

  // Identidad visual
  platformName       String  @default("Campus Virtual") @map("nombre_plataforma")
  logoUrl            String? @map("logo_url")
  faviconUrl         String? @map("favicon_url")
  primaryColor       String  @default("#1e3a8a") @map("color_primario")
  secondaryColor     String  @default("#ea580c") @map("color_secundario")
  font               String  @default("Inter") @map("fuente")
  borderRadius       Int     @default(12) @map("border_radius")
  loginBackgroundUrl String? @map("login_fondo_url")

  // Operativa
  welcomeMessage String @default("Bienvenido") @map("mensaje_bienvenida") @db.VarChar(500)
  timeZone       String @default("America/Bogota") @map("zona_horaria")
  maxFileMb      Int    @default(10) @map("max_archivo_mb")

  // Certificados
  certCustomTitle        String? @map("cert_titulo_personalizado")
  certSubtitle           String? @map("cert_subtitulo")
  certLegalText          String? @map("cert_texto_legal") @db.Text
  certShowModules        Boolean @default(true) @map("cert_mostrar_modulos")
  certShowResources      Boolean @default(true) @map("cert_mostrar_recursos")
  certShowScore          Boolean @default(true) @map("cert_mostrar_nota")
  certShowSignature      Boolean @default(true) @map("cert_mostrar_firma")
  certShowEnrollmentDate Boolean @default(false) @map("cert_mostrar_fecha_ingreso")
  /**
   * Meses que acredita un certificado de esta sede. Nulo o 0 = sin caducidad.
   */
  certValidityMonths     Int?    @map("cert_vigencia_meses")

  // Landing
  landingHeroTitle1   String @default("Transporte Seguro,") @map("landing_hero_titulo1")
  landingHeroTitle2   String @default("Personal Capacitado") @map("landing_hero_titulo2")
  landingHeroSubtitle String @map("landing_hero_subtitulo") @db.Text

  landingPhone     String @map("landing_telefono")
  landingPhoneSub  String @default("Lun-Vie 8am-6pm") @map("landing_telefono_sub")
  landingEmail     String @map("landing_email")
  landingEmailSub  String @default("Respuesta en 24h") @map("landing_email_sub")
  landingOffice    String @map("landing_oficina")
  landingOfficeSub String @map("landing_oficina_sub")

  landingFooterText String @map("landing_footer_texto") @db.Text

  // Legal. El responsable del tratamiento se identifica en la política y en el aviso de privacidad.
  legalEntityName  String?   @map("legal_razon_social")
  legalEntityTaxId String?   @map("legal_identificacion")
  legalAddress     String?   @map("legal_domicilio")
  privacyEmail     String?   @map("legal_email_privacidad")
  // Fecha de la versión vigente de los textos legales; cambia al editarlos.
  legalUpdatedAt   DateTime? @map("legal_actualizado")
  legalTerms       String?   @map("legal_terminos") @db.MediumText
  legalPrivacy     String?   @map("legal_privacidad") @db.MediumText
  legalData        String?   @map("legal_datos") @db.MediumText

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("lms_configuracion")
}

// ── Plantillas de correo ───────────────────────────────────────────────────

model EmailEvent {
  id          Int             @id @default(autoincrement())
  key         String          @unique @map("identificador") // Ej: 'RECUPERAR_PASSWORD'
  displayName String          @map("nombre_legible")
  description String          @map("descripcion")
  variables   String          @db.Text // JSON: ["nombre", "token", ...]
  templates   EmailTemplate[]

  @@map("lms_eventos_correo")
}

model EmailTemplate {
  id           Int        @id @default(autoincrement())
  eventId      Int        @map("evento_id")
  event        EmailEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // Cada sede edita sus propios correos: la de una sede nunca cambia los de la otra.
  country      Country    @map("pais")
  internalName String     @map("nombre_interno")
  subject      String     @map("asunto")
  bodyHtml     String     @map("cuerpo_html") @db.MediumText
  active       Boolean    @default(true) @map("activo")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([eventId, country])
  @@map("lms_plantillas_correo")
}

// ── Versiones de los textos legales ────────────────────────────────────────

/// Lo que decía cada versión de los textos legales de una sede: la prueba de lo que aceptó
/// cada persona, cuyo `consentimiento_version` apunta a `version`. Se escribe al publicarse
/// la versión, en la misma transacción que la configuración, y no se modifica después.
/// Un campo nulo significa que se publicó el texto de serie del campus, que vive en el código
/// del cliente (`BASE_LEGAL_DATE`) y se versiona con él.
model LegalVersion {
  id               Int      @id @default(autoincrement())
  country          Country  @map("pais")
  /// El mismo valor que queda en `consentimiento_version` de usuarios y solicitudes.
  version          String   @db.VarChar(40)
  legalEntityName  String?  @map("razon_social")
  legalEntityTaxId String?  @map("identificacion")
  legalAddress     String?  @map("domicilio")
  privacyEmail     String?  @map("email_privacidad")
  legalTerms       String?  @map("terminos") @db.MediumText
  legalPrivacy     String?  @map("privacidad") @db.MediumText
  legalData        String?  @map("datos") @db.MediumText
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([country, version])
  @@map("lms_versiones_legales")
}

// ── Entregas de vueltas anteriores ─────────────────────────────────────────

/**
 * Entrega de una vuelta ya certificada, sin archivo: se borró al emitirse su certificado.
 * Al rematricular a quien ya obtuvo el certificado, sus entregas se trasladan aquí para que
 * empiece de cero conservando el nombre, la nota y el comentario de cada una. Es el registro
 * de lo calificado que respalda los certificados anteriores: la aplicación no lo muestra, y
 * sólo se borra con la cuenta o con el curso.
 */
model ArchivedSubmission {
  guid            String    @id // El de la entrega original
  userGuid        String    @map("usuario_guid")
  user            User      @relation(fields: [userGuid], references: [guid], onDelete: Cascade)
  courseGuid      String    @map("curso_guid")
  course          Course    @relation(fields: [courseGuid], references: [guid], onDelete: Cascade)
  assignmentGuid  String?   @map("tarea_guid")
  assignment      Resource? @relation(fields: [assignmentGuid], references: [guid], onDelete: SetNull)
  // Título de la actividad al archivarla, por si después se borra.
  assignmentTitle String    @map("tarea_titulo")

  attachmentName String?          @map("respuesta_texto")
  status         SubmissionStatus @map("estado")
  attemptNumber  Int              @map("intento_numero")
  submittedAt    DateTime?        @map("fecha_entrega")
  score          Decimal?         @map("calificacion") @db.Decimal(5, 2)
  feedback       String?          @map("comentario_calificacion") @db.Text
  archivedAt     DateTime         @default(now()) @map("fecha_archivo")

  @@index([userGuid, courseGuid])
  @@index([courseGuid])
  @@map("lms_entregas_archivadas")
}

// ── Registro de subidas ────────────────────────────────────────────────────

/**
 * Quién subió cada archivo.
 * Una clave sólo puede guardarse en un curso, recurso, firma o configuración si la subió
 * quien la guarda: sin este registro, cualquiera podría apuntar a un archivo ajeno (de otro
 * profesor o de la otra sede), descargarlo y, al sustituirlo, borrarlo.
 */
model StoredFile {
  key          String   @id @map("clave") @db.VarChar(191)
  folder       String   @map("carpeta") @db.VarChar(20)
  uploaderGuid String   @map("subido_por")
  country      Country  @map("pais")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([uploaderGuid])
  @@map("lms_archivos")
}
